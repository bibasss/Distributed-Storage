CORE_CONF_fs_defaultFS=hdfs://namenode:9000
HDFS_CONF_dfs_replication=2

# --- Additions to the lab's file (see README.md, "Deviations") -------------
# Variable names follow the bde2020 convention: "___" -> "-", "_" -> ".".
#
# Declare a stopped DataNode dead after 2 x 10 s + 10 x 3 s = 50 s instead of
# the default 2 x 5 min + 10 x 3 s = 10.5 min, so the Under-Replicated state
# of the fault-injection experiment appears within a minute.
HDFS_CONF_dfs_namenode_heartbeat_recheck___interval=10000
HDFS_CONF_dfs_heartbeat_interval=3
# WebHDFS (HTTP read path used by the latency benchmark) and no permission
# checks for the lab user.
HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false
